"#!/usr/bin/env python3\n\"\"\"Read-only GPU artifact inspection. JSON summaries use the shared diagnosis API.\n\nNo pickle deserialization, network requests, checkpoint deletion or GPU resets.\nRun: python denpex_artifacts.py memory-snapshot snapshot.json > evidence.json\n     python denpex_artifacts.py nsight trace.sqlite > evidence.json\n     python denpex_artifacts.py checkpoints /path/to/checkpoints > evidence.json\n     python denpex_artifacts.py stragglers step-times.json > evidence.json\n\"\"\"\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport sqlite3\nimport statistics\nimport time\nfrom pathlib import Path\n\nMAX_JSON_BYTES = 16 * 1024 * 1024\nMAX_ITEMS = 100000\n\n\ndef load_json(path):\n    with Path(path).open(\"rb\") as stream:\n        raw = stream.read(MAX_JSON_BYTES + 1)\n    if len(raw) > MAX_JSON_BYTES:\n        raise ValueError(\"JSON artifact exceeds the 16 MiB local inspection limit\")\n    return json.loads(raw, parse_constant=lambda value: (_ for _ in ()).throw(ValueError(\"Nonfinite JSON number\")))\n\n\ndef number(value):\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0:\n        raise ValueError(\"Expected a finite nonnegative measurement\")\n    return value\n\n\ndef report(module, metrics, findings, limitations=None, status=\"COMPLETE\"):\n    value = {\"denpexArtifactVersion\": 1, \"module\": module, \"status\": status,\n             \"metrics\": metrics, \"findings\": findings[:20], \"limitations\": (limitations or [])[:20]}\n    if len(json.dumps(value, allow_nan=False).encode(\"utf-8\")) > 256000:\n        return {\"denpexArtifactVersion\": 1, \"module\": module, \"status\": \"INCOMPLETE\", \"metrics\": {}, \"findings\": [],\n                \"limitations\": [\"Summary exceeds the 256 KB transport budget. Inspect a smaller artifact window.\"]}\n    return value\n\n\ndef flight_recorder(path):\n    import re\n    path = Path(path)\n    files = sorted(path.glob(\"*\")) if path.is_dir() else [path]\n    files = [item for item in files if item.is_file() and not item.is_symlink()]\n    if not 1 <= len(files) <= 64:\n        raise ValueError(\"Provide 1 to 64 JSON rank dumps in a dedicated directory\")\n    dumps, ranks = [], set()\n    for item in files:\n        data = load_json(item)\n        if not isinstance(data, dict) or not isinstance(data.get(\"entries\"), list):\n            raise ValueError(\"Expected a PyTorch Flight Recorder JSON dump\")\n        rank = data.get(\"rank\")\n        if rank is None:\n            match = re.search(r\"rank[_-]?(\\d+)(?:\\.|$)\", item.name)\n            rank = int(match[1]) if match else None\n        if isinstance(rank, bool) or not isinstance(rank, int) or rank < 0 or rank in ranks:\n            raise ValueError(\"Every dump needs a unique explicit rank or rank-number filename\")\n        ranks.add(rank)\n        fields = (\"pg_id\", \"process_group\", \"collective_seq_id\", \"profiling_name\", \"op_id\", \"record_id\", \"state\", \"input_sizes\",\n                  \"output_sizes\", \"input_dtypes\", \"output_dtypes\", \"reset_epoch\", \"reset_epoch_\", \"is_p2p\")\n        if len(data[\"entries\"]) > 1000:\n            raise ValueError(\"Inspect a shorter flight recorder window, at most 1000 entries per rank\")\n        entries = [{key: entry[key] for key in fields if key in entry} for entry in data[\"entries\"] if isinstance(entry, dict)]\n        clean = {\"rank\": rank, \"entries\": entries}\n        for key in (\"version\", \"timeout\", \"timed_out\", \"reset_epoch\", \"reset_epoch_\"):\n            if key in data:\n                clean[key] = data[key]\n        dumps.append(clean)\n    return report(\"flight-recorder\", {\"dumps\": dumps}, [],\n                  [\"JSON only. A recorded in-flight collective is not a deadlock without explicit watchdog timeout evidence.\",\n                   \"A rank absent from a dump cannot establish a CPU, DataLoader or hardware cause.\"])\n\n\ndef memory_snapshot(data):\n    if not isinstance(data, dict) or not isinstance(data.get(\"segments\"), list):\n        raise ValueError(\"Expected PyTorch memory snapshot JSON with a segments array\")\n    devices = {}\n    count = 0\n    for segment in data[\"segments\"]:\n        count += 1\n        if count > MAX_ITEMS:\n            raise ValueError(\"Snapshot exceeds the segment/block budget\")\n        device = segment.get(\"device\")\n        if isinstance(device, bool) or not isinstance(device, int) or device < 0:\n            raise ValueError(\"Each memory segment must identify its CUDA device\")\n        metrics = devices.setdefault(device, {\"device\": device, \"reservedBytes\": 0, \"requestedBytes\": 0,\n                                             \"requestedSizesAvailable\": True,\n                                             \"allocatedBlockBytes\": 0, \"awaitingFreeBytes\": 0,\n                                             \"inactiveBytes\": 0, \"largestInactiveBlockBytes\": 0, \"allocations\": []})\n        if len(devices) > 256:\n            raise ValueError(\"Snapshot exceeds the device budget\")\n        total = number(segment.get(\"total_size\"))\n        metrics[\"reservedBytes\"] += total\n        block_total = 0\n        for block in segment.get(\"blocks\", []):\n            count += 1\n            if count > MAX_ITEMS:\n                raise ValueError(\"Snapshot exceeds the segment/block budget\")\n            size = number(block.get(\"size\"))\n            block_total += size\n            state = block.get(\"state\")\n            if state == \"active_allocated\":\n                raw_requested = block.get(\"requested_size\")\n                requested = number(raw_requested) if raw_requested is not None else None\n                if requested is not None and requested > size:\n                    raise ValueError(\"Requested memory exceeds its allocator block\")\n                if requested is None:\n                    metrics[\"requestedSizesAvailable\"] = False\n                else:\n                    metrics[\"requestedBytes\"] += requested\n                metrics[\"allocatedBlockBytes\"] += size\n                frames = [frame for frame in block.get(\"frames\", []) if isinstance(frame, dict)\n                          and not any(part in str(frame.get(\"filename\", \"\")).replace(chr(92), \"/\")\n                                      for part in (\"/torch/\", \"torch/\", \"c10d\", \"pythonrun.c\", \"_memory_viz.py\"))][:8]\n                locations = [f\"{Path(str(frame.get('filename', 'unknown')).replace(chr(92), '/')).name[:160]}:{frame.get('line', 0)} ({str(frame.get('name', 'allocation'))[:80]})\"\n                             for frame in frames]\n                metrics[\"allocations\"].append({\"requestedBytes\": requested, \"allocatedBlockBytes\": size, \"locations\": locations})\n            elif state == \"active_awaiting_free\":\n                metrics[\"awaitingFreeBytes\"] += size\n            elif state == \"inactive\":\n                metrics[\"inactiveBytes\"] += size\n                metrics[\"largestInactiveBlockBytes\"] = max(metrics[\"largestInactiveBlockBytes\"], size)\n            else:\n                raise ValueError(\"Unsupported allocator block state\")\n        if block_total != total:\n            raise ValueError(\"Segment size does not match block coverage\")\n    findings = []\n    for device, metrics in devices.items():\n        if not metrics[\"requestedSizesAvailable\"]:\n            metrics[\"requestedBytes\"] = None\n        metrics[\"alignmentWasteBytes\"] = metrics[\"allocatedBlockBytes\"] - metrics[\"requestedBytes\"] if metrics[\"requestedSizesAvailable\"] else None\n        reserved = metrics[\"reservedBytes\"]\n        metrics[\"requestedPercent\"] = round(metrics[\"requestedBytes\"] / reserved * 100, 2) if reserved and metrics[\"requestedSizesAvailable\"] else None\n        metrics[\"inactivePercent\"] = round(metrics[\"inactiveBytes\"] / reserved * 100, 2) if reserved else None\n        metrics[\"awaitingFreePercent\"] = round(metrics[\"awaitingFreeBytes\"] / reserved * 100, 2) if reserved else None\n        metrics[\"allocations\"] = sorted(metrics[\"allocations\"], key=lambda item: item[\"allocatedBlockBytes\"], reverse=True)[:5]\n        traces = data.get(\"device_traces\", [])\n        events = traces[device] if device < len(traces) else []\n        if len(events) > MAX_ITEMS:\n            raise ValueError(\"Snapshot exceeds the device-event budget\")\n        oom = [event for event in events if event.get(\"action\") == \"oom\"]\n        metrics[\"oomEvents\"] = [{\"requestedBytes\": number(event.get(\"size\")),\n                                 \"deviceFreeBytes\": number(event.get(\"device_free\"))} for event in oom[-5:]]\n        if oom:\n            findings.append({\"code\": \"OOM_EVENT\", \"detail\": f\"CUDA device {device} recorded {len(oom)} OOM event(s). Allocation stacks identify contributors, not a proven offending layer.\"})\n    return report(\"memory-snapshot\", {\"devices\": list(devices.values())}, findings,\n                  [\"Inactive reserved bytes alone do not prove fragmentation. Awaiting-free blocks are unavailable until their streams complete.\",\n                   \"Snapshot JSON only. Export trusted PyTorch snapshots locally; pickle uploads are never executed.\"])\n\n\ndef _gaps(intervals):\n    end = None\n    gaps = []\n    for start, stop in sorted(intervals):\n        if end is not None and start > end:\n            gaps.append((end, start))\n        end = stop if end is None else max(end, stop)\n    return gaps\n\n\ndef nsight(path, deadline_seconds=5.0):\n    if not 0 < deadline_seconds <= 5:\n        raise ValueError(\"Trace query deadline must be greater than zero and at most five seconds\")\n    path = Path(path).resolve(strict=True)\n    end = time.monotonic() + deadline_seconds\n    conn = sqlite3.connect(path.as_uri() + \"?mode=ro\", uri=True, timeout=0.1)\n    try:\n        conn.execute(\"PRAGMA query_only=ON\")\n        conn.execute(\"PRAGMA trusted_schema=OFF\")\n        if hasattr(conn, \"setlimit\"):\n            conn.setlimit(sqlite3.SQLITE_LIMIT_LENGTH, 1024 * 1024)\n        conn.set_progress_handler(lambda: int(time.monotonic() >= end), 1000)\n        names = {row[0] for row in conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")}\n        if not {\"CUPTI_ACTIVITY_KIND_KERNEL\", \"StringIds\"}.issubset(names):\n            raise ValueError(\"Unsupported Nsight SQLite schema\")\n        columns = {row[1] for row in conn.execute(\"PRAGMA table_info(CUPTI_ACTIVITY_KIND_KERNEL)\")}\n        if not {\"start\", \"end\", \"deviceId\", \"streamId\", \"demangledName\"}.issubset(columns):\n            raise ValueError(\"Unsupported Nsight kernel columns\")\n        rows = conn.execute(\"SELECT start,end,deviceId,streamId,demangledName FROM CUPTI_ACTIVITY_KIND_KERNEL LIMIT ?\",\n                            (MAX_ITEMS + 1,)).fetchall()\n        if len(rows) > MAX_ITEMS:\n            raise ValueError(\"Trace exceeds the kernel budget; export a shorter trace window\")\n        ids = dict(conn.execute(\"SELECT id,substr(value,1,160) FROM StringIds LIMIT ?\", (MAX_ITEMS + 1,)).fetchall())\n        if len(ids) > MAX_ITEMS:\n            raise ValueError(\"Trace exceeds the string budget\")\n        groups, devices, streams = {}, {}, {}\n        for start, stop, device, stream, name in rows:\n            if time.monotonic() >= end:\n                raise TimeoutError(\"Trace inspection exceeded five seconds\")\n            number(start)\n            number(stop)\n            if stop < start:\n                raise ValueError(\"Invalid kernel interval\")\n            groups.setdefault(name, []).append(stop - start)\n            devices.setdefault(device, []).append((start, stop))\n            streams.setdefault((device, stream), []).append((start, stop))\n        top = sorted(({\"name\": str(ids.get(name, \"unknown\"))[:160], \"calls\": len(values),\n                       \"totalMs\": round(sum(values) / 1e6, 3), \"medianMs\": round(statistics.median(values) / 1e6, 3),\n                       \"maxMs\": round(max(values) / 1e6, 3)} for name, values in groups.items()),\n                     key=lambda item: item[\"totalMs\"], reverse=True)[:10]\n        medians = {name: statistics.median(values) for name, values in groups.items() if len(values) >= 6}\n        outliers = [{\"name\": str(ids.get(name, \"unknown\"))[:160], \"device\": device, \"stream\": stream,\n                     \"durationMs\": round((stop - start) / 1e6, 3), \"medianMs\": round(medians[name] / 1e6, 3),\n                     \"slowdownRatio\": round((stop - start) / medians[name], 2)}\n                    for start, stop, device, stream, name in rows\n                    if name in medians and medians[name] > 0 and stop - start > 10 * medians[name]]\n        device_gaps = [{\"device\": device, \"gapMs\": round((stop - start) / 1e6, 3)}\n                       for device, values in devices.items() for start, stop in _gaps(values) if stop - start >= 2000000]\n        stream_gaps = [{\"device\": device, \"stream\": stream, \"gapMs\": round((stop - start) / 1e6, 3)}\n                       for (device, stream), values in streams.items() for start, stop in _gaps(values) if stop - start >= 2000000]\n        if time.monotonic() >= end:\n            raise TimeoutError(\"Trace inspection exceeded five seconds\")\n        return report(\"nsight\", {\"kernelCount\": len(rows), \"topKernels\": top,\n                                 \"outlierKernels\": sorted(outliers, key=lambda item: item[\"slowdownRatio\"], reverse=True)[:10],\n                                 \"deviceKernelGaps\": sorted(device_gaps, key=lambda item: item[\"gapMs\"], reverse=True)[:10],\n                                 \"streamGaps\": sorted(stream_gaps, key=lambda item: item[\"gapMs\"], reverse=True)[:10]}, [],\n                      [\"Device kernel gaps cover captured kernels only. Copies and other GPU engines can still be active.\"])\n    finally:\n        conn.close()\n\n\ndef stragglers(data):\n    # Compare multiple aligned steps; never declare a GPU defective from one slow sample.\n    if not isinstance(data, dict) or not 2 <= len(data) <= 4096:\n        raise ValueError(\"Provide 2 to 4096 rank timing arrays\")\n    times = {}\n    for rank, samples in data.items():\n        if not str(rank).isdigit() or not isinstance(samples, list) or not 3 <= len(samples) <= 1000:\n            raise ValueError(\"Each rank needs 3 to 1000 aligned step times\")\n        for sample in samples:\n            if number(sample) == 0:\n                raise ValueError(\"Step times must be positive\")\n        times[rank] = samples\n    lengths = {len(samples) for samples in times.values()}\n    if len(lengths) != 1:\n        raise ValueError(\"Rank timing arrays must contain the same aligned steps\")\n    medians = [statistics.median([samples[i] for samples in times.values()]) for i in range(next(iter(lengths)))]\n    result, findings = [], []\n    for rank, samples in times.items():\n        ratios = [value / medians[i] for i, value in enumerate(samples)]\n        ratio = statistics.median(ratios)\n        result.append({\"rank\": int(rank), \"medianSlowdownRatio\": round(ratio, 3), \"samples\": len(samples)})\n        if ratio > 1.35:\n            findings.append({\"code\": \"SLOW_RANK\", \"detail\": f\"Rank {rank} median aligned-step slowdown is {ratio:.2f}x. Investigate workload, host and fabric evidence before assigning a hardware cause.\"})\n    return report(\"stragglers\", {\"ranks\": result}, findings)\n\n\ndef checkpoints(root):\n    root = Path(root).resolve(strict=True)\n    if not root.is_dir():\n        raise ValueError(\"Checkpoint root must be a directory\")\n    import re\n    candidates = []\n    deadline = time.monotonic() + 25\n    for index, child in enumerate(root.iterdir()):\n        if index >= 4096 or time.monotonic() >= deadline:\n            raise ValueError(\"Checkpoint inspection exceeded the directory or time budget\")\n        match = re.fullmatch(r\"step-(0|[1-9]\\d*)\", child.name)\n        if not match or child.is_symlink() or not child.is_dir():\n            continue\n        if len(candidates) >= 1000:\n            raise ValueError(\"Checkpoint root exceeds the candidate budget\")\n        metadata = child / \".metadata\"\n        manifest = child / \"denpex-manifest.json\"\n        candidate = {\"step\": int(match[1]), \"status\": \"UNVERIFIED\", \"checkedShards\": 0}\n        if not metadata.is_file() or metadata.is_symlink() or metadata.stat().st_size == 0:\n            candidate[\"status\"] = \"INCOMPLETE\"\n        elif manifest.is_file() and not manifest.is_symlink():\n            # This manifest attests shard coverage. DCP pickle metadata is never loaded here.\n            doc = load_json(manifest)\n            shards = doc.get(\"shards\", [])\n            if not isinstance(shards, list) or not 1 <= len(shards) <= 4096:\n                raise ValueError(\"Checkpoint manifest needs 1 to 4096 shards\")\n            names = set()\n            complete = True\n            for shard in shards:\n                name = shard.get(\"name\")\n                if not isinstance(name, str) or Path(name).name != name or name in names or not name.endswith(\".distcp\"):\n                    raise ValueError(\"Manifest shard names must be unique local .distcp files\")\n                names.add(name)\n                item = child / name\n                expected = shard.get(\"sha256\", \"\")\n                if not re.fullmatch(r\"[a-f0-9]{64}\", expected):\n                    raise ValueError(\"Manifest needs a SHA256 for every shard\")\n                size = number(shard.get(\"sizeBytes\"))\n                if size == 0 or not item.is_file() or item.is_symlink() or item.stat().st_size != size:\n                    complete = False\n                    continue\n                digest = hashlib.sha256()\n                with item.open(\"rb\") as stream:\n                    for chunk in iter(lambda: stream.read(1024 * 1024), b\"\"):\n                        if time.monotonic() >= deadline:\n                            raise TimeoutError(\"Checkpoint hashing exceeded the time budget\")\n                        digest.update(chunk)\n                candidate[\"checkedShards\"] += 1\n                if digest.hexdigest() != expected:\n                    complete = False\n            candidate[\"status\"] = \"MANIFEST_MATCH\" if complete else \"INCOMPLETE\"\n        candidates.append(candidate)\n    candidates.sort(key=lambda item: item[\"step\"], reverse=True)\n    return report(\"checkpoints\", {\"candidates\": candidates[:100]}, [],\n                  [\"A metadata file alone does not verify DCP shard coverage. Manifest matches require a trusted complete manifest and a successful DCP load before automated resume.\",\n                   \"Read-only discovery. No checkpoint is deleted, purged or automatically selected for rollback.\"])\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"module\", choices=[\"flight-recorder\", \"memory-snapshot\", \"nsight\", \"checkpoints\", \"stragglers\"])\n    parser.add_argument(\"path\")\n    args = parser.parse_args(argv)\n    try:\n        if args.module == \"flight-recorder\":\n            value = flight_recorder(args.path)\n        elif args.module == \"nsight\":\n            value = nsight(args.path)\n        elif args.module == \"checkpoints\":\n            value = checkpoints(args.path)\n        else:\n            data = load_json(args.path)\n            value = memory_snapshot(data) if args.module == \"memory-snapshot\" else stragglers(data)\n        print(json.dumps(value, allow_nan=False))\n        return 0\n    except (OSError, ValueError, TypeError, KeyError, AttributeError, sqlite3.Error, TimeoutError) as error:\n        print(json.dumps(report(args.module, {}, [], [str(error)[:300]], \"INCOMPLETE\")))\n        return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"
